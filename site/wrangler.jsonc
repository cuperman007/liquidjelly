{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "liquidjelly-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "d1_databases": [{"binding": "DB", "database_name": "liquidjelly-enquiries", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations"}],
  "vars": {"TURNSTILE_SITE_KEY": "", "ALLOWED_HOSTS": "liquidjelly-website.mark-f44.workers.dev,www.liquidjelly.co.uk,liquidjelly.co.uk"},
  "triggers": {"crons": ["17 3 * * *"]},
  "observability": {"enabled": true, "head_sampling_rate": 0.1}
}
