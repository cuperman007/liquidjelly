{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "liquidjelly-website",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "liquidjelly-enquiries",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "TURNSTILE_SITE_KEY": "",
    "ALLOWED_HOSTS": "liquidjelly-website.pages.dev,www.liquidjelly.co.uk,liquidjelly.co.uk"
  },
  "pages_build_output_dir": "./dist"
}
